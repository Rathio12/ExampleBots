# Copy this file to ".env" and fill in your values. NEVER commit your real .env!

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=your-bot-token-here

# Optional: a server (guild) ID for instant command registration while developing.
# Leave empty to register commands globally (can take up to an hour to appear).
GUILD_ID=
