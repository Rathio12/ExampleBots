# Copy this file to ".env" and fill in your values. NEVER commit your real .env!

# --- Required ---------------------------------------------------------------
DISCORD_TOKEN=your-bot-token-here

# --- Optional ---------------------------------------------------------------
# Register commands to one server (instant) instead of globally (slow).
GUILD_ID=

# Channel where new members are welcomed.
# Setting this enables the privileged "Server Members Intent" — turn it on in the
# Developer Portal (Bot -> Privileged Gateway Intents) or login will fail!
WELCOME_CHANNEL_ID=

# Channel where /feedback submissions are posted (otherwise they are only logged).
FEEDBACK_CHANNEL_ID=

# --- Game server player count ------------------------------------------------
# A Minecraft server address, e.g. play.example.net or 1.2.3.4:25565
# When set, the bot's status shows the live player count.
GAME_SERVER_ADDRESS=

# Optional voice/text channel that gets renamed to "🟢 Players: 12/100".
# Discord only allows 2 channel renames per 10 minutes, so keep the interval >= 5.
STATUS_CHANNEL_ID=
STATUS_INTERVAL_MINUTES=5

# debug | info | warn | error
LOG_LEVEL=info
