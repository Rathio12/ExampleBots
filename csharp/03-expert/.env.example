# Copy this file to ".env" and fill in your values. NEVER commit your real .env!
#
# This bot uses TWO privileged intents. Enable both in the Developer Portal
# (your app -> Bot -> Privileged Gateway Intents):
#   - SERVER MEMBERS INTENT   (join/leave/role logs, moderation)
#   - MESSAGE CONTENT INTENT  (showing content of edited/deleted messages)

# --- Required ---------------------------------------------------------------
DISCORD_TOKEN=your-bot-token-here

# --- Optional ---------------------------------------------------------------
# Register commands to one server (instant) instead of globally.
GUILD_ID=

# Where the SQLite database file is stored.
DATABASE_PATH=./data/bot.db

# Trace | Debug | Information | Warning | Error
LOG_LEVEL=Information

# Set to "production" for JSON logs (one object per line).
ENVIRONMENT=development

# XP settings for the leveling system.
XP_MIN=15
XP_MAX=25
XP_COOLDOWN_SECONDS=60
